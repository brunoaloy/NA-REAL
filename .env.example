# Public mobile/web configuration. Never insert service_role or moderation secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Also accepts EXPO_PUBLIC_SUPABASE_ANON_KEY when the canonical variable is absent.
# Licensed production style, e.g. MapTiler; public key with quotas/restrictions.
EXPO_PUBLIC_MAP_STYLE_URL=

# Only for a local HTTP Supabase development instance. Keep 0 for hosted/production.
NA_REAL_ALLOW_LOCAL_HTTP=0

# Distribution identity (configure in your own EAS project, not credentials).
NA_REAL_IOS_BUNDLE_ID=
NA_REAL_ANDROID_PACKAGE=
EXPO_PUBLIC_EAS_PROJECT_ID=
# testflight chooses the builtin native map; Expo Go always uses it.
EXPO_PUBLIC_NATIVE_MAP_PROVIDER=
