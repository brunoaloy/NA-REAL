{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.22.1",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "node": "24.22.1",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "24.22.1",
      "environment": "production",
      "env": {
        "NA_REAL_REQUIRE_SERVICES": "1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
