  "scripts": {
    "start": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.cjs",
    "test:db": "bash scripts/test-db.sh",
    "test:smoke": "node tests/smoke.cjs",
    "format:check": "prettier --check src tests docs package.json",
    "test:functions": "npx deno check supabase/functions/moderate-pending/index.ts supabase/functions/prepare-photo/index.ts supabase/functions/delete-account/index.ts supabase/functions/delete-photo/index.ts",
    "services:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-services.cjs",
    "services:start": "supabase start --exclude studio,logflare,vector,imgproxy,supavisor,postgres-meta",
    "services:stop": "supabase stop",
    "test:services": "node scripts/test-services.cjs",
    "mobile:check": "node scripts/check-mobile-config.cjs",
    "test:reviews-ui": "node tests/reviews-smoke.cjs",
    "remote:prepare": "node scripts/remote-migrations.cjs prepare",
    "remote:verify": "node scripts/remote-migrations.cjs verify",
    "start:tunnel": "expo start --go --tunnel ngrok",
    "start:lan": "expo start --go --lan",
    "start:dev-client": "expo start --dev-client",
    "phone": "node scripts/start-phone.cjs"
  },
  "private": true
